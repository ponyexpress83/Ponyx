# Database (SQLite for local, Turso/LibSQL URL for production)
DATABASE_URL="file:prisma/dev.db"

# Auth — REQUIRED in production. Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# Only needed for local dev
NEXTAUTH_URL="http://localhost:3000"

# Optional: For real AI responses instead of mock data
# ANTHROPIC_API_KEY="your-anthropic-api-key"
